"""
SWEA - 1263. 사람 네트워크 2

간선 가중치가 모두 1로 같으니 BFS나 다익스트라로 최단 경로를 구해야할 것 같은데?

# 1. 테스트 케이스 입력을 받는다.
# 2. BFS를 구현하여,
    # 2-1. 방문 여부 및 거리를 기록할 배열 (-1로 초기화하여 방문 체크 겸용)
    # 2-2. BFS 탐색을 위한 큐를 초기화한다.
    # 2-3. 큐가 빌 때까지 탐색
            # 2-3-1. 인접해 있고(간선 존재) 아직 방문하지 않은 경우
            # 2-3-2. 데크에 삽입
    # 2-4. 시작 노드에서 다른 모든 노드까지의 최단 거리 합 반환
# 3. 가장 작은 값을 출력한다.
"""
from collections import deque
from typing import List


N: int
graph: List[List[int]]


def input_test_case() -> None:
    global N, graph
    inputs = list(map(int, input().split()))

    N, matrix_data = inputs[0], inputs[1:]
    graph = [matrix_data[i*N:(i+1)*N] for i in range(N)]


# 2. BFS를 구현하여,
def search(start_node: int) -> int:
    # 2-1. 방문 여부 및 거리를 기록할 배열 (-1로 초기화하여 방문 체크 겸용)
    distance = [-1] * N
    distance[start_node] = 0

    # 2-2. BFS 탐색을 위한 큐 초기화
    queue = deque([start_node])

    # 2-3. 큐가 빌 때까지 탐색
    while queue:
        curr = queue.popleft()

        for next_node in range(N):
            # 2-3-1. 인접해 있고(간선 존재) 아직 방문하지 않은 경우
            if graph[curr][next_node] == 1 and distance[next_node] == -1:
                # 2-3-2. 데크에 삽입
                distance[next_node] = distance[curr] + 1
                queue.append(next_node)

    # 2-4. 시작 노드에서 다른 모든 노드까지의 최단 거리 합 반환
    return sum(distance)


def prob_1263():
    T: int = int(input().strip())

    for tc in range(1, T+1):
        # 1. 테스트 케이스 입력을 받는다.
        input_test_case()

        result: List = []

        for i in range(N):
            result.append(search(i))
        # 3. 가장 작은 값을 출력한다.
        print(f"#{tc} {min(result)}")


if __name__ == '__main__':
    prob_1263()
